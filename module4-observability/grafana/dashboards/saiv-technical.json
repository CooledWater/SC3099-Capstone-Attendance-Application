      "id": 5,
      "title": "Service availability",
      "type": "timeseries",
      "targets": [{"expr": "up{job=~\"saiv-backend|saiv-face-recognition\"}", "legendFormat": "{{job}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 6,
      "title": "Risk score distribution",
      "type": "timeseries",
      "description": "Recorded check-ins in each rolling hour. Low: score < 0.3; Medium: 0.3 <= score < 0.5; High: 0.5 <= score < 0.7; Critical: score >= 0.7. Four-level history starts when the level counters were deployed.",
      "targets": [
        {"expr": "sum(increase(checkin_risk_level_total{band=\"low\"}[1h]))", "legendFormat": "Low", "refId": "A"},
        {"expr": "sum(increase(checkin_risk_level_total{band=\"medium\"}[1h]))", "legendFormat": "Medium", "refId": "B"},
        {"expr": "sum(increase(checkin_risk_level_total{band=\"high\"}[1h]))", "legendFormat": "High", "refId": "C"},
        {"expr": "sum(increase(checkin_risk_level_total{band=\"critical\"}[1h]))", "legendFormat": "Critical", "refId": "D"}
      ]
    }
