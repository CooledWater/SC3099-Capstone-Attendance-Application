        {"expr": "100 * sum(rate(http_requests_total{service=\"backend\",status_class=\"5xx\"}[5m])) / sum(rate(http_requests_total{service=\"backend\"}[5m]))", "legendFormat": "5xx", "refId": "B"}
      ]
