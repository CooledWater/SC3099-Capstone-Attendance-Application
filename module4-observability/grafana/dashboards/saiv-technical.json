      "id": 2,
      "title": "Backend p95 response latency",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"backend\"}[5m]))) * 1000", "legendFormat": "p95 ms", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
