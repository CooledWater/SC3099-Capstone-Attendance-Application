# Only for running the backend OUTSIDE Docker (uvicorn from a local venv).
# Copy to module2-backend/.env (git-ignored). Inside Docker, compose sets these itself.
#
# Start the local database and Redis first:  docker compose up -d postgres redis
# Host ports come from the root compose file (postgres 5434, redis 6380).
DATABASE_URL=postgresql://saiv:saiv_password@localhost:5434/saiv
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
FACE_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
STRICT_SECURITY_MODE=false
