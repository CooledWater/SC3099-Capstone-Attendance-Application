# Root environment for `docker compose`. Copy to `.env` (git-ignored) and adjust.
# Every value has a working default, so `docker compose up --build` also works with no .env.
#
# The backend always connects to the bundled `postgres` container; compose builds its
# DATABASE_URL from the POSTGRES_* values below. No external database is required.

# --- Local PostgreSQL (container `saiv-postgres`) ---------------------------------------
# Use URL-safe characters (letters, digits, - _ .) in the password: it is embedded in a URL.
POSTGRES_USER=saiv
POSTGRES_PASSWORD=saiv_password
POSTGRES_DB=saiv
# Host port for psql / a backend run outside Docker (container port is always 5432).
POSTGRES_HOST_PORT=5434

# --- Backend security -------------------------------------------------------------------
# Use a random string of 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# true = production hardening (rejects placeholder JWT_SECRET, blocks self-registration of
# staff/admin roles). Keep false to create the first admin via POST /api/v1/auth/register.
STRICT_SECURITY_MODE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
FORWARDED_ALLOW_IPS=

# --- Optional features ------------------------------------------------------------------
# Web push (generate keys with scripts/configure-push.py). Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# ISO date (YYYY-MM-DD) used for semester week numbering.
SEMESTER_START_DATE=

# --- Face service (Module 3) ------------------------------------------------------------
PAD_MODE=enforce
PAD_THRESHOLD=0.75
FACE_MATCH_HAMMING_FRACTION=0.1171875
